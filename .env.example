# --- BACKEND SETTINGS ---
PROJECT_NAME="ParkGuard — Parking Management & Barcode System"
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-with-a-cryptographically-secure-random-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./parkguard.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
INITIAL_ADMIN_EMAIL=admin@parkguard.local
INITIAL_ADMIN_NAME="Super Administrator"
INITIAL_ADMIN_PASSWORD=replace-with-secure-admin-password
LOG_LEVEL=INFO

# --- FRONTEND SETTINGS ---
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
