# ========================================================
# ParkGuard — Parking Management & Barcode System
# Backend Environment Configuration (.env.example)
# NOTE: Replace placeholder values for production deployment
# ========================================================

# General Configuration
PROJECT_NAME="ParkGuard — Parking Management & Barcode System"
ENVIRONMENT=development
DEBUG=true

# Security & Tokens (DO NOT commit production secret keys!)
SECRET_KEY=replace-with-a-cryptographically-secure-random-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection
# SQLite development database:
DATABASE_URL=sqlite:///./parkguard.db
# PostgreSQL production example:
# DATABASE_URL=postgresql://username:password@db-host:5432/parkguard_prod

# CORS Allowed Origins (Comma-separated list of permitted frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Initial Bootstrap Super Administrator
INITIAL_ADMIN_EMAIL=admin@parkguard.local
INITIAL_ADMIN_NAME="Super Administrator"
INITIAL_ADMIN_PASSWORD=replace-with-secure-admin-password

# Logging
LOG_LEVEL=INFO
